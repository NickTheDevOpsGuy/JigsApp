{
  "globs": [
    "**/*.md",
    "!node_modules/**",
    "!.git/**",
    "!dist/**",
    "!coverage/**",
    "!test-results/**",
  ],
  "config": {
    "default": true,
    "MD013": false,
    "MD018": false,
    "MD024": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD045": false,
    "MD051": false,
  },
}
